{
  "manifest_version": 3,
  "name": "LGS Blank-Probe Blocker",
  "version": "1.0.0",
  "description": "Stops portal.lgsonlinesolutions.com from opening about:blank popup-blocker probe tabs that steal focus.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["tabs"],
  "host_permissions": [
    "https://portal.lgsonlinesolutions.com/*",
    "https://*.lgsonlinesolutions.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.lgsonlinesolutions.com/*",
        "https://*.lgsonlinesolutions.com/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "LGS Blank-Probe Blocker (active on LGS portal)",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
