{
  "manifest_version": 3,
  "name": "Texas Appellate Highlighter",
  "version": "1.1.0",
  "description": "Highlights Texas appellate case-search rows by CCA PDR stage and Bennett COA stage using the IACLS databases.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://search.txcourts.gov/*",
    "https://iacls.org/*",
    "https://www.iacls.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://search.txcourts.gov/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Texas Appellate Highlighter",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
